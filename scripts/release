#!/bin/sh
# Cut a beamer-ntua release in one step, so a tag is never created before it is verified:
#
#   scripts/release 0.4.0
#
# Rewrites the version references (workflow default, README example), runs the checks,
# commits, tags and pushes main and the tag together. Nothing is committed, tagged or
# pushed if any step fails, and a published tag is never moved: fix forward with a new version.
set -eu

die() { echo "error: $*" >&2; exit 1; }

version="${1:?usage: scripts/release X.Y.Z}"
case "$version" in
  [0-9]*.[0-9]*.[0-9]*) ;;
  *) die "version must look like 1.2.3" ;;
esac
tag="v$version"

cd "$(git rev-parse --show-toplevel)"
workflow=.github/workflows/course-ci.yml

[ "$(git branch --show-current)" = main ] || die "not on main"
[ -z "$(git status --porcelain)" ] || die "working tree is not clean"
git fetch -q origin
[ "$(git rev-parse HEAD)" = "$(git rev-parse origin/main)" ] || die "main is not in sync with origin/main"
git rev-parse -q --verify "refs/tags/$tag" >/dev/null && die "tag $tag already exists locally"
git ls-remote --exit-code --tags origin "refs/tags/$tag" >/dev/null 2>&1 && die "tag $tag already exists on origin"

restore() { git checkout -q -- "$workflow" README.md; }
trap 'restore' EXIT

sed -i "s|^\(        default: \)v[0-9][0-9.]*|\1$tag|" "$workflow"
sed -i "s|course-ci\.yml@v[0-9][0-9.]*|course-ci.yml@$tag|" README.md
grep -q "default: $tag" "$workflow" || die "could not set the workflow default"
grep -q "course-ci.yml@$tag" README.md || die "could not set the README example"

sh tests/course-tooling-smoke.sh
if command -v prek >/dev/null 2>&1; then prek run --all-files; fi

git add "$workflow" README.md
git commit -q -m "chore(release): $tag

- Set the course-ci default beamer-ref and the README example to $tag"
trap - EXIT
git tag -a "$tag" -m "release(beamer-ntua): $tag"
git push --atomic origin main "$tag"
echo "released $tag"
